[Unit]
Description=Open 5D Chess game server
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/projects/open5dchess/release/server
# Binds to localhost; expose via Tailscale (serve/funnel) or a reverse proxy.
Environment=PORT=8090
Environment=HOST=127.0.0.1
# Pi 3B has 1 GB RAM shared with other services: one analysis worker is enough.
Environment=ANALYSIS_WORKERS=1
# Shorter inline mate-check budget: the Pi CPU is ~6x slower than the dev PC.
Environment=END_QUICK_MS=150
# Full mate-search budget (worker pool); the zy-class mate proof measures 107s
# on the Pi 3B, so the game ends ~2min after the mate exists (async verdict)
Environment=END_SEARCH_MS=150000
# Set to the public origin (e.g. the Funnel URL) so invite links are correct
# behind the proxy. Drop-in override: /etc/systemd/system/open5dchess.service.d/
Environment=PUBLIC_URL=
ExecStart=/usr/local/bin/node src/index.js
Restart=on-failure
RestartSec=5

# Containment on a small shared machine
MemoryMax=350M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
